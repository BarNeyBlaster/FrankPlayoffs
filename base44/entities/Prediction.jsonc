{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "description": "Display name of the predictor"
    },
    "afc_seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "7 AFC team ids"
    },
    "nfc_seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "7 NFC team ids"
    },
    "sb_champion": {
      "type": "string",
      "description": "Predicted Super Bowl champion team id"
    },
    "sb_score_champ": {
      "type": "integer",
      "description": "Predicted champion's final score"
    },
    "sb_score_opp": {
      "type": "integer",
      "description": "Predicted opponent's final score"
    }
  },
  "required": [
    "nickname",
    "afc_seeds",
    "nfc_seeds",
    "sb_champion",
    "sb_score_champ",
    "sb_score_opp"
  ]
}