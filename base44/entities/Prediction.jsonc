{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "description": "Display name of the predictor"
    },
    "afc_seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "7 AFC team ids"
    },
    "nfc_seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "7 NFC team ids"
    },
    "picks": {
      "type": "object",
      "description": "Legacy bracket picks (unused)",
      "additionalProperties": true
    },
    "champion": {
      "type": "string",
      "description": "Legacy predicted champion (unused)"
    },
    "champion_name": {
      "type": "string",
      "description": "Legacy champion display name (unused)"
    }
  },
  "required": [
    "nickname",
    "afc_seeds",
    "nfc_seeds"
  ]
}